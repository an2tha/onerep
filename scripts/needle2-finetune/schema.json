  {
    "name": "search_food",
    "description": "Show what the food catalogue has for a name, with nutrition, without logging anything.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "What to search for, e.g. 'greek yoghurt'",
          "minLength": 2
        },
        "limit": {
          "type": "integer",
          "description": "How many candidates to return. Fewer is easier to choose from.",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "query"
      ]
    }
  },
  {
    "name": "log_food",
    "description": "Log a food by name and portion — the everyday case. Searches the catalogue and logs the best match.",
    "parameters": {
      "type": "object",
      "properties": {
        "food": {
          "type": "string",
          "description": "What was eaten, e.g. 'greek yoghurt'",
          "minLength": 2
        },
        "grams": {
          "type": "number",
          "description": "Portion in grams",
          "exclusiveMinimum": 0,
          "maximum": 5000
        },
        "meal": {
          "type": "string",
          "enum": [
            "breakfast",
            "lunch",
            "dinner",
            "snack"
          ],
          "description": "Which meal it belongs to"
        },
        "date": {
          "type": "string",
          "description": "A date as YYYY-MM-DD, or 'today' / 'yesterday' / 'tomorrow'"
        }
      },
      "required": [
        "food"
      ]
    }
  },
  {
