{
  "name": "onerep",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format --continue && prettier --write \"**/*.{md,json,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "check-types": "bun run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@convex-dev/better-auth": "^0.11.4",
    "@convex-dev/crons": "^0.2.0",
    "better-auth": "1.5.3",
    "convex": "^1.35.1"
  }
}
