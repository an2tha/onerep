{
  "name": "onerep",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format --continue && prettier --write \"**/*.{md,json,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "check-types": "bun run typecheck",
    "test": "bun test --path-ignore-patterns \"convex/__tests__\" --path-ignore-patterns \"apps/data-api/loaders/datasets\"",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "test:watch": "bun test --watch --path-ignore-patterns \"convex/__tests__\" --path-ignore-patterns \"apps/data-api/loaders/datasets\"",
    "test:coverage": "bun test --coverage --path-ignore-patterns \"convex/__tests__\" --path-ignore-patterns \"apps/data-api/loaders/datasets\""
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@vitest/coverage-v8": "^4.1.4",
    "convex-test": "^0.0.49",
    "prettier": "^3.7.4",
    "turbo": "^2.9.4",
    "typescript": "5.9.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@convex-dev/better-auth": "^0.11.4",
    "@convex-dev/crons": "^0.2.0",
    "better-auth": "1.5.3",
    "convex": "^1.35.1",
    "cors": "^2.8.6",
    "helmet": "^8.1.0"
  }
}
