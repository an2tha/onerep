{
  "name": "onerep",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docker:dev:reqs": "docker compose -f docker-compose.dev-requirements.yml up -d",
    "docker:dev:reqs:seed": "docker compose -f docker-compose.dev-requirements.yml --profile seed up off-seed",
    "docker:dev:reqs:logs": "docker compose -f docker-compose.dev-requirements.yml logs -f",
    "docker:dev:reqs:down": "docker compose -f docker-compose.dev-requirements.yml down",
    "exercises:prepare": "bun scripts/prepare-free-exercise-db.ts",
    "exercises:import": "bun run exercises:prepare && bunx convex import --table exercises --replace --format jsonArray --yes .cache/exercises/free-exercise-db.compact.json",
    "lint": "turbo run lint",
    "format": "turbo run format --continue && prettier --write \"**/*.{md,json,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "check-types": "bun run typecheck",
    "test": "bun test --path-ignore-patterns \"convex/__tests__\"",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "test:watch": "bun test --watch --path-ignore-patterns \"convex/__tests__\"",
    "test:coverage": "bun test --coverage --path-ignore-patterns \"convex/__tests__\""
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@vitest/coverage-v8": "^4.1.4",
    "bun-types": "^1.3.12",
    "convex-test": "^0.0.49",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/crons": "^0.2.0",
    "@revenuecat/purchases-js": "^1.47.0",
    "@types/pg": "^8.20.0",
    "better-auth": "1.6.23",
    "cli-progress": "^3.12.0",
    "convex": "^1.39.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "pg": "^8.20.0"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "@xmldom/xmldom": "^0.9.10",
    "brace-expansion": "^5.0.6",
    "dompurify": "^3.4.7",
    "esbuild": "^0.28.0",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.23",
    "ip-address": "^10.2.0",
    "postcss": "^8.5.15",
    "protobufjs": "^8.5.0",
    "qs": "^6.15.2",
    "ws": "^8.21.0"
  }
}
