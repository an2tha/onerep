{
  "name": "onerep",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "billing:ensure": "node scripts/ensure-billing-provider.mjs",
    "build": "bun run billing:ensure && bun run prompts:check && turbo run build",
    "dev": "bun run billing:ensure && turbo run dev",
    "build:ios": "bun run build --filter mobile -- --mode development && cd apps/mobile && bunx cap sync ios",
    "run:ios": "cd apps/mobile && bunx cap run ios",
    "open:ios": "cd apps/mobile && bunx cap open ios",
    "exercises:prepare": "bun scripts/prepare-free-exercise-db.ts",
    "exercises:import": "bun run exercises:prepare && bunx convex import --table exercises --replace --format jsonArray --yes .cache/exercises/free-exercise-db.compact.json",
    "lint": "turbo run lint",
    "format": "turbo run format --continue && prettier --write \"**/*.{md,json,yml,yaml}\"",
    "typecheck": "bun run billing:ensure && bun run prompts:check && turbo run typecheck",
    "check-types": "bun run typecheck",
    "test": "bun run billing:ensure && bun run prompts:check && turbo run test test:convex-unit",
    "test:convex-unit": "bun test --max-concurrency 1 ./convex/ai/provider.test.ts ./convex/lib/__tests__/calculateCalories.test.ts ./convex/lib/__tests__/estimateOnboardingCalories.test.ts ./convex/lib/__tests__/coachWorkspaceBudget.test.ts ./convex/lib/__tests__/outreach.test.ts ./convex/lib/__tests__/programming.test.ts ./convex/lib/__tests__/recovery.test.ts ./convex/lib/__tests__/healthScore.test.ts ./convex/lib/__tests__/healthSeries.test.ts ./convex/lib/__tests__/history.test.ts ./convex/lib/__tests__/memoryConsolidation.test.ts ./convex/lib/__tests__/dataImport.test.ts",
    "icons:build": "node scripts/build-icons.mjs",
    "prompts:generate": "node scripts/generate-ai-prompts.mjs",
    "prompts:check": "node scripts/generate-ai-prompts.mjs --check",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "models:fetch": "bun scripts/pose-models/fetch.ts",
    "models:publish": "bun scripts/pose-models/publish.ts",
    "models:fetch:ios": "bun scripts/pose-models/fetch.ts --coreml",
    "models:publish:ios": "bun scripts/pose-models/publish.ts --coreml",
    "test:ota": "bun test --max-concurrency 1 ./scripts/ota ./apps/mobile/src/lib/__tests__/ota.test.ts ./apps/mobile/src/lib/__tests__/ota-manifest.test.ts ./apps/mobile/src/lib/__tests__/service-worker.test.ts ./apps/mobile/capacitor-config.test.ts ./apps/mobile/public-assets.test.ts",
    "test:watch": "bun test --watch --path-ignore-patterns \"convex/__tests__\"",
    "test:coverage": "bun test --coverage --path-ignore-patterns \"convex/__tests__\""
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@vitest/coverage-v8": "^4.1.4",
    "bun-types": "^1.3.12",
    "convex-test": "^0.0.49",
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/crons": "^0.2.0",
    "@convex-dev/migrations": "0.3.6",
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/openai": "^1.5.8",
    "@types/pg": "^8.20.0",
    "better-auth": "1.6.23",
    "cli-progress": "^3.12.0",
    "convex": "1.43.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "@xmldom/xmldom": "^0.9.10",
    "brace-expansion": "^5.0.6",
    "dompurify": "^3.4.7",
    "esbuild": "^0.28.0",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.23",
    "ip-address": "^10.2.0",
    "postcss": "^8.5.15",
    "protobufjs": "^8.5.0",
    "qs": "^6.15.2",
    "ws": "^8.21.0"
  }
}
