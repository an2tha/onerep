# Convex
CONVEX_DEPLOYMENT=
CONVEX_URL=
VITE_CONVEX_URL=
CONVEX_SITE_URL=
VITE_CONVEX_SITE_URL=
SITE_URL=https://app.onerep.life
VITE_APP_URL=https://app.onerep.life

# Auth / analytics
BETTER_AUTH_SECRET=
# Unset or `false` (the default): accounts work without verifying their email.
# `true` needs an email provider configured in Convex env (RESEND_API_KEY,
# AUTH_EMAIL_FROM).
EMAIL_VERIFICATION_REQUIRED=
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=

# Self-hosted datasource service. Set these in Convex env; never expose them to Vite.
DATASOURCE_URL=
DATASOURCE_API_TOKEN=

# AI integrations
# Set these in Convex env; never expose the OpenRouter key to Vite.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
# `true` removes the monthly AI request caps for every account — the default
# on self-hosted installs, where you pay OpenRouter yourself. Leave unset on
# a deployment that meters usage.
AI_USAGE_UNLIMITED=

# Billing. Set in Convex env, not Vite. Every account has Pro by default;
# only a deployment that actually sells subscriptions needs any of this —
# see docs/billing.md.
BILLING_MONTHLY_PRICE_LABEL="€4/month"
BILLING_CHECKOUT_SUCCESS_URL=https://app.onerep.life/settings#success
BILLING_CHECKOUT_CANCEL_URL=https://app.onerep.life/settings#failed

# Optional integrations configured entirely with `bunx convex env set` (they
# have no place in a local env file): Google sign-in (GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET) and a real payment provider (docs/billing.md).
