# Convex
CONVEX_DEPLOYMENT=
CONVEX_URL=
VITE_CONVEX_URL=
CONVEX_SITE_URL=
VITE_CONVEX_SITE_URL=
SITE_URL=https://app.onerep.life
VITE_APP_URL=https://app.onerep.life
VITE_SITE_URL=https://onerep.life

# Auth / analytics
BETTER_AUTH_SECRET=
# Google sign-in. Set both in Convex env; the button hides when either is empty.
# Authorized redirect URI: https://<deployment>.convex.site/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_AI_PLAN_SLUG=ai-access
VITE_CLERK_AI_PLAN_ID=
# Clerk issuer URL for Convex auth, e.g. https://your-app.clerk.accounts.dev
# Set this in Convex env as well: bunx convex env set CLERK_JWT_ISSUER_DOMAIN <url>
CLERK_JWT_ISSUER_DOMAIN=
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=
RESEND_API_KEY=
AUTH_EMAIL_FROM="OneRep <support@onerep.life>"
AUTH_EMAIL_LOGO_URL=https://app.onerep.life/app-icon.svg

# Self-hosted datasource service. Set these in Convex env; never expose them to Vite.
DATASOURCE_URL=
DATASOURCE_API_TOKEN=
CAPACITOR_DEV_SERVER_URL=
PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5433

# AI integrations
# Set these in Convex env; never expose the OpenRouter key to Vite.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# ── Self-owned billing. Set all of these in Convex env, not Vite. ────────────
# Shared
# Unset or `true` (the default): every signed-in account has Pro. Only a
# deployment that actually sells subscriptions sets this to `false`.
BILLING_COMP_ALL_USERS=
BILLING_MONTHLY_PRICE_LABEL="$9.99/month"
BILLING_CHECKOUT_SUCCESS_URL=https://app.onerep.life/settings#success
BILLING_CHECKOUT_CANCEL_URL=https://app.onerep.life/settings#failed
# Temporary compatibility for installed native versions released before the
# self-owned billing client. Remove after those versions are retired.
REVENUECAT_PUBLIC_SDK_KEY=

# Stripe (web). Webhook endpoint: <convex-site-url>/billing/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=

# Apple (iOS). Notification endpoint: <convex-site-url>/billing/apple/notifications
# APPLE_PRIVATE_KEY is the .p8 App Store Connect key, PEM contents inline.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.onerep.app
APPLE_ENVIRONMENT=production
# Apple Root CA - G3, PEM encoded. Required: App Store Server Notifications are
# rejected without it, because the x5c chain is verified against this root.
# Download the .cer from https://www.apple.com/certificateauthority/ then run:
#   openssl x509 -inform der -in AppleRootCA-G3.cer -out AppleRootCA-G3.pem
APPLE_ROOT_CA_G3=

# Google (Android). RTDN endpoint: <convex-site-url>/billing/google/rtdn
# Service account needs "View financial data" in Play Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PACKAGE_NAME=com.onerep.app
# Pin the Pub/Sub push OIDC token so a token minted for another service is
# rejected even though Google signed it.
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
