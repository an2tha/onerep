# Convex
CONVEX_DEPLOYMENT=
CONVEX_URL=
VITE_CONVEX_URL=
CONVEX_SITE_URL=
VITE_CONVEX_SITE_URL=
SITE_URL=https://app.onerep.life
VITE_APP_URL=https://app.onerep.life

# Auth / analytics
BETTER_AUTH_SECRET=
# Unset or `false` (the default): accounts work without verifying their email.
# `true` needs an email provider configured in Convex env (RESEND_API_KEY,
# AUTH_EMAIL_FROM).
EMAIL_VERIFICATION_REQUIRED=
# Internal dashboard, server-side Convex env only. Admin IDs are canonical
# token identifiers: <CONVEX_SITE_URL>|<Better Auth user _id>, comma-separated.
# Both admin allowlists empty means nobody can access /admin/analytics.
ANALYTICS_ADMIN_USER_IDS=
# Optional email allowlist. Requires a verified account and a valid auth session.
ANALYTICS_ADMIN_EMAILS=
# Additional test accounts, comma-separated. Reserved test domains are automatic.
ANALYTICS_EXCLUDED_USER_IDS=
ANALYTICS_EXCLUDED_EMAILS=
# Umami analytics for the mobile app. Both must be set or no tracker is shipped
# at all, which is the correct behaviour for a self-hosted install: leave them
# empty and nothing reports to a stranger's instance. Use a website id separate
# from any marketing site, or retention numbers and landing-page bounces end up
# in the same bucket.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# Self-hosted datasource service. Set these in Convex env; never expose them to Vite.
DATASOURCE_URL=
DATASOURCE_API_TOKEN=

# AI integrations
# Set these in Convex env; never expose the OpenRouter key to Vite.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Jev for guided workout decisions (server-side only).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
