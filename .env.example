# Convex
CONVEX_DEPLOYMENT=
CONVEX_URL=
VITE_CONVEX_URL=
CONVEX_SITE_URL=
VITE_CONVEX_SITE_URL=
SITE_URL=https://app.onerep.life
VITE_APP_URL=https://app.onerep.life
VITE_SITE_URL=https://onerep.life

# Auth / analytics
BETTER_AUTH_SECRET=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_AI_PLAN_SLUG=ai-access
VITE_CLERK_AI_PLAN_ID=
# Clerk issuer URL for Convex auth, e.g. https://your-app.clerk.accounts.dev
# Set this in Convex env as well: bunx convex env set CLERK_JWT_ISSUER_DOMAIN <url>
CLERK_JWT_ISSUER_DOMAIN=
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=
RESEND_API_KEY=
AUTH_EMAIL_FROM="OneRep <support@onerep.life>"

# Open Food Facts proxy. Set these in Convex env; never expose the token to Vite.
OPENFOODFACTS_URL=https://world.openfoodfacts.org
OPENFOODFACTS_AUTH_TOKEN=
# Upstream Product Opener Docker images are amd64-only as of now.
OFF_PLATFORM=linux/amd64
CAPACITOR_DEV_SERVER_URL=
PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5433

# AI integrations
OPENAI_API_KEY=
OPENAI_METRIC_MODEL=gpt-4o-mini

# RevenueCat. Set these in Convex env, not Vite.
REVENUECAT_SECRET_KEY=
REVENUECAT_API_V2_SECRET_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_PUBLIC_SDK_KEY=
REVENUECAT_WEB_CHECKOUT_URL=https://pay.rev.cat/<your-purchase-link-token>
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_MONTHLY_PRICE_LABEL="$9.99/month"
