{
  "name": "data-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./dist/bin/www.js",
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only ./bin/www.ts",
    "food:download": "mkdir -p data && curl -L --continue-at - --fail --retry 5 --retry-delay 5 --output data/food.parquet https://huggingface.co/datasets/openfoodfacts/product-database/resolve/main/food.parquet",
    "food:index": "python3 scripts/build_food_index.py",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "loader": "bunx tsx src/loaders/main.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "http-errors": "~1.6.3",
    "morgan": "^1.10.1",
    "pg": "^8.13.1",
    "duckdb": "1.1.3",
    "helmet": "^8.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.6",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.10",
    "bun-types": "^1.3.12",
    "drizzle-kit": "^0.31.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0"
  }
}
