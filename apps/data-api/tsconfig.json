{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": ["bin/**/*", "routes/**/*", "middleware/**/*", "src/db/**/*", "src/lib/**/*", "src/loaders/**/*", "scripts/**/*", "app.ts"],
  "exclude": ["node_modules", "dist", "loaders/.venv"]
}