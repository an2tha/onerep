{
  "name": "mobile",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:ios": "concurrently -n vite,cap -c blue,green \"vite --host\" \"wait-on tcp:5173 && bunx cap run ios --target-name 'iPhone 16e'\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "test": "bun test --max-concurrency 1 ./src ./capacitor-config.test.ts ./ios-privacy-manifest.test.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "preview": "vite preview",
    "ios:watch": "./scripts/run-watch.sh",
    "ios:watch:fast": "./scripts/run-watch.sh --no-build",
    "dev:watch": "concurrently -n vite,sim -c blue,green \"vite --host\" \"wait-on tcp:5173 && ./scripts/run-watch.sh\""
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-speech-recognition": "^8.1.7",
    "@capgo/capacitor-updater": "^8.51.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@ionic/react": "^8.8.3",
    "@phosphor-icons/react": "^2.1.10",
    "@posthog/react": "^1.9.1",
    "@repo/models": "*",
    "@repo/ui": "*",
    "@tailwindcss/vite": "^4.2.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "convex": "^1.39.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "motion": "^12.42.2",
    "onnxruntime-web": "^1.27.0",
    "posthog-js": "^1.377.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.11",
    "react-router": "^7.14.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.5",
    "wait-on": "^9.0.10"
  }
}
