# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Capture iOS screenshots (flow:auth or flow:tabs on a signed-in simulator)"
  lane :screenshots do |options|
    flow = options.fetch(:flow, "auth").to_s
    UI.user_error!("Use flow:auth or flow:tabs") unless %w[auth tabs].include?(flow)

    # Resolve from the Fastfile so the lane works from either the app or repo.
    root = File.expand_path("../../../../..", __dir__)
    unless options[:skip_build] == true
      Dir.chdir(root) { sh("bun", "run", "build:ios") }
    end

    capture_screenshots(
      only_testing: ["AppScreenshots/OneRepScreenshots/test#{flow == 'tabs' ? 'MainTabs' : 'Authentication'}"],
      output_directory: File.expand_path("screenshots/#{flow}", __dir__)
    )
  end

  desc "Upload an existing IPA to TestFlight"
  lane :beta do |options|
    ipa = options[:ipa]
    UI.user_error!("Pass the IPA path with ipa:/path/to/app.ipa") if ipa.to_s.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: File.expand_path(
        "~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('APP_STORE_CONNECT_KEY_ID')}.p8"
      )
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end
  desc "Upload an existing IPA to App Store Connect for main App Review"
  lane :store do |options|
    UI.user_error!("Pass the IPA path with ipa:/path/to/app.ipa") if options[:ipa].to_s.empty?
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: File.expand_path(
        "~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('APP_STORE_CONNECT_KEY_ID')}.p8"
      )
    )
    upload_to_app_store(
      api_key: api_key,
      ipa: options[:ipa],
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

end
