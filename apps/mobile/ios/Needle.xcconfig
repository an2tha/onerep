// Build settings for the on-device Needle 2 engine.
//
// The App target uses this configuration for both Debug and Release.
// Project-level debug.xcconfig still supplies CAPACITOR_DEBUG in Debug.
// Fetch the archives with `bun run needle:fetch:native` before building.

// libneedle.a ships one archive per slice. $(CURRENT_ARCH) is wrong here
// because the simulator and the device are both arm64 and need different files.
LIBNEEDLE_DIR[sdk=iphoneos*] = $(SRCROOT)/../../vendor/needle/ios-arm64
LIBNEEDLE_DIR[sdk=iphonesimulator*] = $(SRCROOT)/../../vendor/needle/ios-sim-arm64

LIBRARY_SEARCH_PATHS = $(inherited) $(LIBNEEDLE_DIR)
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/App/Needle

// -lc++ is not optional: the engine is C++ behind a C interface, and without it
// the link fails on ___cxa_throw and a few dozen std:: symbols, which reads
// like a corrupt archive rather than a missing flag.
OTHER_LDFLAGS = $(inherited) -lneedle -lc++

SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/App/Needle/App-Bridging-Header.h
