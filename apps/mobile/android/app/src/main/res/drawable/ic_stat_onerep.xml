<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar notification icon.

  Android renders these as an alpha mask, so this must be a solid white
  silhouette on transparency. Using the launcher icon here (the previous
  behaviour, via Capacitor's fallback) produces a featureless white square.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Outer plate, left -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2,10.25 h1.5 a0.75,0.75 0 0 1 0.75,0.75 v2 a0.75,0.75 0 0 1 -0.75,0.75 h-1.5 a0.75,0.75 0 0 1 -0.75,-0.75 v-2 a0.75,0.75 0 0 1 0.75,-0.75 z" />
    <!-- Inner plate, left -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.5,7.5 h1.75 a1,1 0 0 1 1,1 v7 a1,1 0 0 1 -1,1 h-1.75 a1,1 0 0 1 -1,-1 v-7 a1,1 0 0 1 1,-1 z" />
    <!-- Bar -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.25,10.75 h7.5 v2.5 h-7.5 z" />
    <!-- Inner plate, right -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16.75,7.5 h1.75 a1,1 0 0 1 1,1 v7 a1,1 0 0 1 -1,1 h-1.75 a1,1 0 0 1 -1,-1 v-7 a1,1 0 0 1 1,-1 z" />
    <!-- Outer plate, right -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20.5,10.25 h1.5 a0.75,0.75 0 0 1 0.75,0.75 v2 a0.75,0.75 0 0 1 -0.75,0.75 h-1.5 a0.75,0.75 0 0 1 -0.75,-0.75 v-2 a0.75,0.75 0 0 1 0.75,-0.75 z" />
</vector>
