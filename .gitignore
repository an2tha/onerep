.DS_Store
*.pem


apps/server/.env
apps/server/.env.*
apps/server/data/raw

# AI/tooling scratch files
.ralph
.agents/
.claude/

# Local test-account credentials (never commit)
test-user.txt

# Local-only operator scripts. These read .env.production and deploy straight to
# production without touching CI, which is not something a checkout should be
# able to do by itself.
scripts/*.local.sh

# Generated billing seam files. scripts/ensure-billing-provider.mjs copies the
# checked-in stubs into place when these are missing; on machines with the
# private implementations they point at _private/ instead. The _private/
# directories themselves ARE tracked in the internal repo — it is
# scripts/publish-github.sh that keeps them out of the public mirror.
convex/billing/provider.ts
apps/mobile/src/components/billing/index.tsx

# Local checkout of the public GitHub mirror, generated by
# scripts/publish-github.sh.
.public-mirror/

# ── ML model weights and datasets ─────────────────────────────────────────────
# Large binary artifacts. They are reproducible from the export scripts and
# fetched separately (see scripts/form-JEPA/fetch-dataset.sh), so they do not
# belong in git history.
*.onnx
# ...except the two runtime pose models, which are not "fetched separately" by
# anything. Vite copies them into apps/mobile/dist and they deploy to
# app.onerep.life, which is where the web app and — via otaOrigin() — the native
# app both fetch them from. They are kept out of the OTA zip *because* they are
# served from that origin. Untracking them once already broke CI and would have
# shipped a deploy with no models at all. See apps/mobile/public-assets.test.ts.
!apps/mobile/public/models/*.onnx
*.mlmodel
*.mlmodelc/
*.pt
*.pth
*.ckpt
*.safetensors
*.tflite
*.h5
*.npz
*.pkl
# CoreML packages, wherever they live — including the copies inside the iOS app.
*.mlpackage/
# Trained checkpoints from the form-JEPA training runs.
scripts/form-JEPA/best_epoch.bin
scripts/form-JEPA/models/
scripts/form-JEPA/data/
scripts/form-JEPA/dataset/
scripts/form-JEPA/datasets/
# Regenerated from apps/mobile/public/models by `cap sync`, so it is a build
# artifact even though the originals are tracked.
apps/mobile/ios/App/App/public/models/

ideas.txt
