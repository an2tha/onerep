node_modules
package-lock.json
.pnp
.pnp.js

# Local env files
.env*
!.env.example

# Testing
coverage
test-results/
playwright-report/

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

